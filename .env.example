# Базовый URL API без завершающего слеша.
# Пример для исходного taxi: https://host.example/taxi/c/default/api/v1
VITE_AUTH_API_URL=

# true запускает автономную демонстрацию без запросов к реальному backend.
VITE_USE_MOCK_AUTH=true

# Опциональные значения из site_constants исходного taxi для регистрации водителя.
VITE_DRIVER_PHONE_PREFIX=
VITE_DEFAULT_COUNTRY=
VITE_DEFAULT_LOCATION_CLASS_ID=
